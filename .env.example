# ─── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Service role — server-only (cron / admin). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── App URL (required for OAuth / email redirects) ───────────────────────────
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
SITE_URL=http://localhost:3000

# ─── Cron (required in production for applying due movements) ─────────────────
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_string
